{
  "name": "whatsapp-notion-intake",
  "version": "1.0.0",
  "description": "End-to-end WhatsApp to Notion intake system with AI-powered enrichment",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:notion": "tsx scripts/test-notion.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/storage/migrations/run.ts",
    "worker": "tsx src/queue/worker.ts",
    "admin": "tsx src/admin/server.ts",
    "setup": "bash scripts/setup.sh",
    "docker:build": "docker build -t whatsapp-notion-intake .",
    "docker:run": "docker run -p 3000:3000 --env-file .env whatsapp-notion-intake"
  },
  "keywords": [
    "whatsapp",
    "notion",
    "ai",
    "automation",
    "intake"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@anthropic-ai/sdk": "^0.31.0",
    "@mozilla/readability": "^0.5.0",
    "axios": "^1.7.9",
    "bullmq": "^5.28.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "pg": "^8.13.1",
    "aws-sdk": "^2.1691.0",
    "form-data": "^4.0.1",
    "jsdom": "^25.0.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "tesseract.js": "^5.1.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "winston": "^3.17.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "nanoid": "^3.3.8",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/jsdom": "^21.1.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/cors": "^2.8.17",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
