# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# WhatsApp Configuration (MODE A: Official Cloud API)
WHATSAPP_MODE=official
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret

# WhatsApp Configuration (MODE B: Personal Bridge - OPTIONAL, ToS risk)
# WHATSAPP_MODE=bridge
# WHATSAPP_BRIDGE_API_URL=https://api.unipile.com/v1
# WHATSAPP_BRIDGE_API_KEY=your_bridge_api_key

# Notion Configuration
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI/LLM Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: OpenAI for fallback
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_intake
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# S3/R2 Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=whatsapp-intake-media
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
# For Cloudflare R2, set endpoint to: https://<account_id>.r2.cloudflarestorage.com

# Optional: Local development with MinIO
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1

# Processing Configuration
MAX_RETRIES=3
RETRY_BACKOFF_MS=2000
JOB_TIMEOUT_MS=300000

# Admin UI Configuration
ADMIN_PORT=3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
